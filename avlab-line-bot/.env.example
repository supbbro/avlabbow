PORT=3000
TZ=Asia/Taipei
# Reuse Google Sheets data briefly so LINE replies do not reload every workbook.
SHEETS_CACHE_TTL_MS=60000
# Sheet/tab metadata changes rarely; caching it keeps forced value refreshes fast.
SHEETS_METADATA_CACHE_TTL_MS=600000

# LINE Developers > Messaging API
LINE_CHANNEL_ACCESS_TOKEN=replace_me
LINE_CHANNEL_SECRET=replace_me

# Google Cloud service account (choose JSON or the two split variables)
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
# GOOGLE_CLIENT_EMAIL=bot@project.iam.gserviceaccount.com
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Protects /automation/* endpoints used by optional Apps Script relays.
AUTOMATION_SECRET=replace_with_a_long_random_value

# Native Google Sheet used by external teaching attendance/results.
EXTERNAL_RESULTS_SHEET_ID=1WXeO6VF-emmoP_07tzsGk5z0WGSU7aFLbtbT0ImYACg
